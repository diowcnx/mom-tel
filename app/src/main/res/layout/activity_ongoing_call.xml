<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_ongoing"
    android:fitsSystemWindows="true"
    android:padding="20dp">

    <!-- Ongoing Status & Call Timer -->
    <LinearLayout
        android:id="@+id/layoutOngoingHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvOngoingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/prompt_regular"
            android:text="@string/ongoing_call_title"
            android:textColor="#81D4FA"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvCallDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/prompt_medium"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            tools:text="00:45" />
    </LinearLayout>

    <!-- Center Profile -->
    <LinearLayout
        android:id="@+id/layoutOngoingProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutCallControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutOngoingHeader">

        <!-- Circular Avatar -->
        <FrameLayout
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/viewOngoingAvatarBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_contact_circle" />

            <TextView
                android:id="@+id/tvOngoingAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/prompt_medium"
                android:gravity="center"
                android:textColor="@color/text_white"
                android:textSize="50sp"
                tools:text="ม" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgOngoingAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.ElderPhone.CircleImage"
                tools:src="@drawable/ic_person" />
        </FrameLayout>

        <!-- Name (Prompt Medium) -->
        <TextView
            android:id="@+id/tvOngoingCallerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/prompt_medium"
            android:gravity="center"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            tools:text="ลูกสาว (แป้ง)" />

        <!-- Phone Number (Prompt Regular) -->
        <TextView
            android:id="@+id/tvOngoingCallerNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/prompt_regular"
            android:gravity="center"
            android:textColor="#CFD8DC"
            android:textSize="22sp"
            tools:text="081-234-5678" />

    </LinearLayout>

    <!-- Intermediate Controls (Speakerphone & Mute) - Symmetrical 50/50 -->
    <LinearLayout
        android:id="@+id/layoutCallControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toTopOf="@id/btnOngoingHangup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Speakerphone Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeaker"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#37474F"
            android:fontFamily="@font/prompt_regular"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/btn_speaker_on"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_speaker"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="24dp"
            app:iconTint="@color/text_white"
            app:strokeColor="#78909C"
            app:strokeWidth="1.5dp" />

        <!-- Mute Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMute"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#37474F"
            android:fontFamily="@font/prompt_regular"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/btn_mute"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="24dp"
            app:iconTint="@color/text_white"
            app:strokeColor="#78909C"
            app:strokeWidth="1.5dp" />

    </LinearLayout>

    <!-- Giant End Call Button - Perfectly Spanned -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOngoingHangup"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_end"
        android:fontFamily="@font/prompt_medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_hangup"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        app:backgroundTint="@color/btn_end_red"
        app:cornerRadius="36dp"
        app:icon="@drawable/ic_call_end"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="30dp"
        app:iconTint="@color/text_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
