<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="26dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <!-- Contact Avatar Container -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/actionAvatarBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_contact_circle" />

            <TextView
                android:id="@+id/actionAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/prompt_medium"
                android:gravity="center"
                android:textColor="@color/text_white"
                android:textSize="38sp"
                tools:text="ส" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/actionAvatarImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.ElderPhone.CircleImage" />
        </FrameLayout>

        <!-- Contact Name -->
        <TextView
            android:id="@+id/actionContactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/prompt_medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            tools:text="สุชาติ ศรีวิชัย" />

        <!-- Contact Phone Number -->
        <TextView
            android:id="@+id/actionContactNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp"
            android:fontFamily="@font/prompt_regular"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            tools:text="098-4914245" />

        <!-- 1. Giant Call Button (Significantly Larger Than Other Buttons) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionCall"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/prompt_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="โทรออก"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            app:backgroundTint="@color/btn_answer_green"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_call"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="30dp"
            app:iconTint="@color/text_white"
            app:rippleColor="#80FFFFFF" />

        <!-- 2. Row of Secondary Actions: Edit Name & Change Photo Side by Side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Edit Name Button (Warm Amber) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionEditName"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/prompt_medium"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:text="เปลี่ยนชื่อ"
                android:textColor="#E65100"
                android:textSize="15sp"
                app:backgroundTint="#FFF3E0"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="20dp"
                app:iconTint="#E65100"
                app:rippleColor="#26E65100"
                app:strokeColor="#FFB74D"
                app:strokeWidth="1.5dp" />

            <!-- Change Photo Button (Light Blue) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionChangePhoto"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/prompt_medium"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:text="เปลี่ยนรูปภาพ"
                android:textColor="#0D47A1"
                android:textSize="15sp"
                app:backgroundTint="#E3F2FD"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="20dp"
                app:iconTint="#0D47A1"
                app:rippleColor="#260D47A1"
                app:strokeColor="#90CAF9"
                app:strokeWidth="1.5dp" />
        </LinearLayout>

        <!-- 3. Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:fontFamily="@font/prompt_regular"
            android:text="ยกเลิก"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
