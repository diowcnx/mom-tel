<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardContact"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="11dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeColor="#DCE2E6"
    app:strokeWidth="1.5dp">

    <!-- Center Contact Info (Avatar + Name) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="9dp"
        android:paddingTop="9dp"
        android:paddingBottom="8dp">

        <!-- Rounded Rectangle Avatar Container (Large for elderly visibility) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="8dp">

            <!-- Background shape / rounded rectangle -->
            <View
                android:id="@+id/viewAvatarBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_contact_rounded_rect" />

            <!-- Initial Letter when no photo (Prompt Medium) -->
            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/prompt_medium"
                android:gravity="center"
                android:textColor="@color/text_white"
                android:textSize="44sp"
                tools:text="ม" />

            <!-- Rounded Rectangle Image View for photo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.ElderPhone.RoundedImage" />
        </FrameLayout>

        <!-- Contact Name: Elegant Prompt Medium font -->
        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/prompt_medium"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:paddingBottom="2dp"
            tools:text="ลูกสาว (แป้ง)" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
