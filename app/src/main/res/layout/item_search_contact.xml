<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSearchItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#DCE2E6"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- Avatar Container - Tap to Call -->
        <FrameLayout
            android:id="@+id/layoutSearchAvatar"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/viewSearchAvatarBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_contact_circle" />

            <TextView
                android:id="@+id/tvSearchAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:fontFamily="@font/prompt_medium"
                android:gravity="center"
                android:textColor="@color/text_white"
                android:textSize="26sp"
                tools:text="ส" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgSearchAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.ElderPhone.CircleImage" />
        </FrameLayout>

        <!-- Name & Number -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSearchContactName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/prompt_medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                tools:text="สุชาติ ศรีวิชัย" />

            <TextView
                android:id="@+id/tvSearchContactNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/prompt_regular"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                tools:text="098-4914245" />
        </LinearLayout>

        <!-- Call Indicator Icon -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_call_button">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/btn_call"
                android:src="@drawable/ic_call"
                app:tint="@color/text_white" />
        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
